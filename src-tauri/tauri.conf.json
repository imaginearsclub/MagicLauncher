{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imaginears MagicLauncher",
  "mainBinaryName": "magiclauncher",
  "identifier": "club.imaginears.magiclauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Imaginears MagicLauncher",
        "width": 960,
        "height": 600,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#090d16",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://*.ingest.us.sentry.io https://*.ingest.sentry.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Game",
    "shortDescription": "Installs, updates and launches the Imaginears Magic Pack.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNEM2Njc5NTAyRjgwMTQKUldRVWdDOVFlV1pNcWptRDl1UnBwSnc0RjVMQjc1bEY5enhIZlBWRzNINDdTT0NmM1RSWC9obGIK",
      "endpoints": [
        "https://launcher.imaginears.club/launcher/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
